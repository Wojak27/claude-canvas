#!/usr/bin/env bash
# canvas — push content to the Claude Canvas board in VS Code.
#
#   canvas show <image> [caption ...]   add an image card (symlinked, --copy to copy)
#   canvas note [title ...]             add a markdown card, body on stdin
#   canvas state [file.md]              replace the pinned state block (stdin or file)
#   canvas task session [title ...]     open a new session block in tasks.md
#   canvas task add <text ...>          add a task to the newest session
#   canvas task done|undo|rm <n ...>    by the number from `canvas task list`
#   canvas task list                    print the numbered task list
#   canvas task cleardone               drop finished tasks
#   canvas live add <name> [--every 60s] [--title T]
#                                       a block that re-runs a script (stdin) on a timer
#   canvas live run|rm <name> | ls      run once and print | remove | list
#   canvas widget [title ...]           an interactive chart/table card, JSON spec on stdin
#   canvas title <text ...>             name this conversation's board
#   canvas rm <name> | clear            remove one card | every card
#   canvas open                         bring the board up in VS Code
#   canvas path                         print this conversation's board folder
#
# Each Claude Code conversation writes to its own board. CLAUDE_CANVAS_SESSION picks it (the
# plugin's SessionStart hook sets it); CLAUDE_CANVAS_SESSION=shared writes to the Shared board.
set -euo pipefail

top="${CLAUDE_CANVAS_DIR:-}"
if [ -z "$top" ]; then
  d="$PWD"
  while [ "$d" != "/" ]; do
    # ~/.claude is Claude Code's own config, not a project
    if [ -d "$d/.claude" ] && [ "$d" != "${HOME:-}" ]; then top="$d/.claude/canvas"; break; fi
    d="$(dirname "$d")"
  done
fi
[ -n "$top" ] || { echo "canvas: no project .claude directory above $PWD (set CLAUDE_CANVAS_DIR)" >&2; exit 1; }

session="$(printf '%s' "${CLAUDE_CANVAS_SESSION:-${CLAUDE_CODE_SESSION_ID:-shared}}" | tr -cd 'A-Za-z0-9_-')"
if [ -z "$session" ] || [ "$session" = shared ]; then
  session=shared; root="$top"
else
  root="$top/sessions/$session"
fi
feed="$root/feed"
mkdir -p "$feed"
[ -f "$top/.gitignore" ] || printf '# Claude Canvas board state: local, per machine\n*\n' > "$top/.gitignore"
if [ "$session" != shared ] && [ ! -f "$root/meta.json" ]; then
  CANVAS_META="$root/meta.json" CANVAS_ID="$session" python3 -c '
import json, os, datetime
json.dump({"id": os.environ["CANVAS_ID"], "title": "", "started": datetime.datetime.now().isoformat(timespec="seconds")},
          open(os.environ["CANVAS_META"], "w"), indent=2)'
fi

stamp() { date +%Y%m%d-%H%M%S-%3N; }
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//' | cut -c1-48; }

cmd="${1:-}"; shift || true
case "$cmd" in
  show)
    copy=0
    [ "${1:-}" = "--copy" ] && { copy=1; shift; }
    src="${1:-}"; shift || true
    [ -f "$src" ] || { echo "canvas: no such image: $src" >&2; exit 1; }
    src="$(readlink -f "$src")"
    ext="${src##*.}"
    base="$(stamp)-$(slug "$(basename "${src%.*}")")"
    if [ "$copy" = 1 ]; then cp "$src" "$feed/$base.$ext"; else ln -sfn "$src" "$feed/$base.$ext"; fi
    if [ "$#" -gt 0 ]; then printf '%s\n' "$*" > "$feed/$base.caption.md"; fi
    echo "$feed/$base.$ext"
    ;;
  note)
    title="${*:-}"
    base="$(stamp)${title:+-$(slug "$title")}"
    { [ -n "$title" ] && printf '## %s\n\n' "$title"; cat; } > "$feed/$base.md"
    echo "$feed/$base.md"
    ;;
  state)
    if [ "${1:-}" != "" ] && [ -f "$1" ]; then cp "$1" "$root/state.md"; else cat > "$root/state.md"; fi
    echo "$root/state.md"
    ;;
  task|tasks)
    sub="${1:-list}"; shift || true
    CANVAS_TASKS="$root/tasks.md" CANVAS_SUB="$sub" python3 - "$@" <<'PYEOF'
import os, re, sys, datetime

f = os.environ['CANVAS_TASKS']
sub = os.environ['CANVAS_SUB']
args = sys.argv[1:]
if not os.path.exists(f):
    open(f, 'w').write('# Tasks\n')
lines = open(f).read().split('\n')
TASK = re.compile(r'^(\s*)([-*])\s+\[([ xX])\]\s+(.*)$')
HEAD = re.compile(r'^(#{1,6})\s+(.*)$')

def heads():
    out = []
    for i, l in enumerate(lines):
        m = HEAD.match(l)
        if m:
            out.append((i, len(m.group(1)), m.group(2)))
    return out

def level():
    hs = [h[1] for h in heads()]
    if not hs:
        return 2
    lv = min(hs)
    if lv == 1 and hs.count(1) == 1:
        deeper = [h for h in hs if h > 1]
        return min(deeper) if deeper else 2
    return lv

def task_lines():
    return [i for i, l in enumerate(lines) if TASK.match(l)]

def save():
    open(f, 'w').write('\n'.join(lines))

if sub == 'session':
    title = ' '.join(args) or datetime.date.today().isoformat()
    lv = level()
    at = next((i for i, l, t in heads() if l >= lv), len(lines))
    lines[at:at] = ['#' * lv + ' ' + title, '']
    save()
    print(title)

elif sub == 'add':
    text = ' '.join(args)
    if not text:
        sys.exit('canvas task add: nothing to add')
    lv = level()
    hs = [h for h in heads() if h[1] == lv]
    if not hs:
        at = next((i for i, l, t in heads() if l >= lv), len(lines))
        lines[at:at] = ['#' * lv + ' ' + datetime.date.today().isoformat(), '']
        hs = [h for h in heads() if h[1] == lv]
    start = hs[0][0]
    end = next((i for i, l, t in heads() if i > start and l <= lv), len(lines))
    while end > start + 1 and not lines[end - 1].strip():
        end -= 1
    lines[end:end] = ['- [ ] ' + text]
    save()
    print(text)

elif sub in ('done', 'undo', 'rm'):
    idx = task_lines()
    for n in sorted({int(a) for a in args if a.isdigit()}, reverse=True):
        if not 1 <= n <= len(idx):
            print('canvas: no task %d' % n, file=sys.stderr)
            continue
        i = idx[n - 1]
        if sub == 'rm':
            del lines[i]
        else:
            lines[i] = re.sub(r'\[[ xX]\]', '[x]' if sub == 'done' else '[ ]', lines[i], count=1)
    save()

elif sub == 'cleardone':
    lines[:] = [l for l in lines if not (TASK.match(l) and TASK.match(l).group(3).lower() == 'x')]
    save()

else:
    n = 0
    for l in lines:
        h = HEAD.match(l)
        m = TASK.match(l)
        if h:
            print('\n' + h.group(2))
        elif m:
            n += 1
            print('%3d %s %s' % (n, '[x]' if m.group(3).lower() == 'x' else '[ ]', m.group(4)))
PYEOF
    ;;
  live)
    # The extension re-runs live/<name>.sh while the board is visible and shows its stdout.
    sub="${1:-ls}"; shift || true
    live="$root/live"
    # scripts run from the workspace root the extension recorded, same as when it runs them
    ws="$(head -1 "$top/.workspace" 2>/dev/null || true)"
    [ -d "$ws" ] || ws="$(cd "$top/../.." && pwd)"
    mkdir -p "$live"
    status() {  # name exit ms stderr-file
      CANVAS_ST="$live/$1.status.json" python3 - "$2" "$3" "$4" <<'PYEOF'
import json, os, sys, datetime
code, ms, errf = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
err = open(errf).read().strip() if os.path.exists(errf) else ''
json.dump({"exit": code, "stderr": err, "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), "ms": ms},
          open(os.environ["CANVAS_ST"], "w"), indent=2)
PYEOF
    }
    runone() {
      local out code t0 errf
      errf="$(mktemp)"; t0="$(date +%s%3N)"
      set +e; out="$(cd "$ws" && bash "$live/$1.sh" 2>"$errf")"; code=$?; set -e
      status "$1" "$code" "$(( $(date +%s%3N) - t0 ))" "$errf"
      if [ "$code" -ne 0 ]; then
        cat "$errf" >&2; rm -f "$errf"
        echo "canvas live: $1 exited $code; the board keeps its last output" >&2
        return 1
      fi
      rm -f "$errf"
      printf '%s\n' "$out" > "$live/$1.md.tmp" && mv "$live/$1.md.tmp" "$live/$1.md"
      printf '%s\n' "$out"
    }
    case "$sub" in
      add)
        name="$(slug "${1:-}")"; shift || true
        [ -n "$name" ] || { echo "canvas live add: need a name" >&2; exit 1; }
        every=60s; title=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --every) every="$2"; shift 2 ;;
            --title) title="$2"; shift 2 ;;
            *) echo "canvas live add: unknown option $1" >&2; exit 1 ;;
          esac
        done
        body="$(cat)"
        [ -n "$body" ] || { echo "canvas live add: script goes on stdin" >&2; exit 1; }
        {
          printf '#!/usr/bin/env bash\n# every: %s\n' "$every"
          [ -n "$title" ] && printf '# title: %s\n' "$title"
          printf '%s\n' "$body"
        } > "$live/$name.sh.tmp"
        mv "$live/$name.sh.tmp" "$live/$name.sh"
        runone "$name"
        ;;
      run)
        [ -f "$live/${1:-}.sh" ] || { echo "canvas live: no block ${1:-}" >&2; exit 1; }
        runone "$1"
        ;;
      rm)
        for n in "$@"; do rm -f "$live/$n.sh" "$live/$n.md" "$live/$n.status.json"; done
        ;;
      ls|list)
        # name, interval, last run (from status.json: whoever ran it last, CLI or extension), title
        CANVAS_LIVE="$live" python3 - <<'PYEOF'
import glob, json, os, re, datetime
live = os.environ["CANVAS_LIVE"]
for f in sorted(glob.glob(os.path.join(live, "*.sh"))):
    name = os.path.basename(f)[:-3]
    head = open(f).read().split("\n")[:15]
    get = lambda k: next((m.group(1) for l in head for m in [re.match(r"^#\s*%s\s*:\s*(.+?)\s*$" % k, l)] if m), "")
    st, last = os.path.join(live, name + ".status.json"), "never run"
    if os.path.exists(st):
        s = json.load(open(st))
        age = (datetime.datetime.now().astimezone() - datetime.datetime.fromisoformat(s["at"])).total_seconds()
        ago = "%ds" % age if age < 60 else "%dm" % (age // 60) if age < 3600 else "%dh" % (age // 3600)
        last = ("ok" if s["exit"] == 0 else "FAILED exit %d" % s["exit"]) + ", " + ago + " ago"
        if s["exit"] != 0 and s.get("stderr"):
            last += " -- " + s["stderr"].splitlines()[-1][:80]
    print("%-18s every %-5s %-28s %s" % (name, get("every") or "60s", last, get("title")))
PYEOF
        ;;
      *) echo "canvas live: add | run | rm | ls" >&2; exit 1 ;;
    esac
    ;;
  widget)
    # Validates the spec (same rules as the extension) so a bad one fails here, not as a red card.
    title="${*:-}"
    spec="$(cat)"
    ws="$(head -1 "$top/.workspace" 2>/dev/null || true)"
    [ -d "$ws" ] || ws="$(cd "$top/../.." && pwd)"
    CANVAS_SPEC="$spec" CANVAS_WS="$ws" python3 - <<'PYEOF' || exit 1
import json, os, sys
try:
    s = json.loads(os.environ["CANVAS_SPEC"])
except Exception as e:
    sys.exit("canvas widget: spec is not valid JSON: %s" % e)
errs, t = [], s.get("type") if isinstance(s, dict) else None
if t not in ("line", "bar", "scatter", "heatmap", "stat", "table"):
    errs.append('"type" must be one of line, bar, scatter, heatmap, stat, table')
elif t == "stat":
    if not s.get("items"): errs.append('a stat widget needs "items": [{"label", "value"}]')
else:
    if not isinstance(s.get("data"), list) and not isinstance(s.get("src"), str):
        errs.append('needs "data" (array of rows) or "src" (a data file)')
    if isinstance(s.get("src"), str):
        p = s["src"] if os.path.isabs(s["src"]) else os.path.join(os.environ["CANVAS_WS"], s["src"])
        if not os.path.exists(p): errs.append("src not found: %s (relative paths are from the workspace root)" % p)
    if t in ("line", "bar", "scatter"):
        if not s.get("x"): errs.append('a %s widget needs "x"' % t)
        if not s.get("y"): errs.append('a %s widget needs "y"' % t)
        if s.get("series") and isinstance(s.get("y"), list): errs.append('use "series" or a list of "y" columns, not both')
    if t == "heatmap" and not (s.get("x") and s.get("y") and s.get("value")):
        errs.append('a heatmap needs "x", "y" and "value"')
if errs: sys.exit("canvas widget: " + "; ".join(errs))
PYEOF
    [ -n "$title" ] || title="$(printf '%s' "$spec" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("title") or "widget")')"
    out="$feed/$(stamp)-$(slug "$title").widget.json"
    printf '%s\n' "$spec" > "$out"
    echo "$out"
    ;;
  title)
    [ "$session" != shared ] || { echo "canvas title: the Shared board has a fixed name" >&2; exit 1; }
    CANVAS_META="$root/meta.json" python3 - "$*" <<'PYEOF'
import json, os, sys
p = os.environ["CANVAS_META"]
m = json.load(open(p)) if os.path.exists(p) else {}
m["title"] = sys.argv[1].strip()[:80]
json.dump(m, open(p, "w"), indent=2)
print(m["title"])
PYEOF
    ;;
  rm)
    for n in "$@"; do rm -f "$feed/$n" "$feed/${n%.*}.caption.md"; done
    ;;
  clear)
    find "$feed" -maxdepth 1 -type f -delete 2>/dev/null || true
    find "$feed" -maxdepth 1 -type l -delete 2>/dev/null || true
    ;;
  open)
    # the sentinel lives at the top; its content says which board to show
    printf '%s\n' "$session" > "$top/.open"
    ;;
  path) echo "$root" ;;
  *) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
