{
  "name": "claude-canvas",
  "displayName": "Claude Canvas",
  "description": "A live board Claude Code can write to: one per conversation, with interactive widgets, live command output, notes and images.",
  "version": "0.7.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:claudeCanvas.panel"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Live blocks run the shell scripts in .claude/canvas/live/, so they stay paused until the workspace is trusted."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCanvas",
          "title": "Claude Canvas",
          "icon": "media/canvas.svg"
        }
      ]
    },
    "views": {
      "claudeCanvas": [
        {
          "type": "webview",
          "id": "claudeCanvas.board",
          "name": "Board"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCanvas.focus",
        "title": "Claude Canvas: Show Board"
      },
      {
        "command": "claudeCanvas.openPanel",
        "title": "Claude Canvas: Open Conversation in Editor Tab"
      },
      {
        "command": "claudeCanvas.clearFeed",
        "title": "Claude Canvas: Clear Feed"
      },
      {
        "command": "claudeCanvas.revealFolder",
        "title": "Claude Canvas: Reveal Canvas Folder"
      },
      {
        "command": "claudeCanvas.openTasks",
        "title": "Claude Canvas: Open tasks.md"
      },
      {
        "command": "claudeCanvas.newSession",
        "title": "Claude Canvas: Start Task Session"
      }
    ],
    "configuration": {
      "title": "Claude Canvas",
      "properties": {
        "claudeCanvas.folder": {
          "type": "string",
          "default": ".claude/canvas",
          "description": "Canvas folder, relative to the workspace root. Its top level is the Shared board; each conversation has one under sessions/<id>/."
        },
        "claudeCanvas.newestFirst": {
          "type": "boolean",
          "default": true,
          "description": "Show the most recent feed card at the top."
        },
        "claudeCanvas.maxCards": {
          "type": "number",
          "default": 60,
          "description": "Maximum number of feed cards to render."
        },
        "claudeCanvas.autoReveal": {
          "type": "string",
          "enum": [
            "always",
            "never"
          ],
          "default": "always",
          "description": "Reveal the board automatically when a new feed card appears."
        },
        "claudeCanvas.liveBlocks": {
          "type": "boolean",
          "default": true,
          "description": "Re-run the scripts in live/ on their interval while the board is visible (trusted workspaces only)."
        },
        "claudeCanvas.maxConversations": {
          "type": "number",
          "default": 20,
          "description": "Conversations listed in the board's picker, most recently active first."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wojak27/claude-canvas.git"
  },
  "homepage": "https://github.com/Wojak27/claude-canvas#readme",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "dashboard",
    "images",
    "tasks",
    "webview"
  ]
}
